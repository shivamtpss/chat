# Stage 03 config. Copy to .env and adjust.
# Postgres on 5436, Redis on 6380 (host already runs a Redis on 6379).
DATABASE_URL=postgres://chat:chat@localhost:5436/chat
REDIS_URL=redis://localhost:6380

# Each running instance MUST have a unique SERVER_ID. The npm scripts
# start:a / start:b set these for you.
SERVER_ID=A
PORT=3001
HOST=0.0.0.0

PG_POOL_MAX=10
AUTH_SECRET=dev-only-change-me
LOG_LEVEL=info

# Presence heartbeat: how often we refresh the user->server key, and its TTL.
# TTL must be comfortably larger than the interval so a brief hiccup does not
# expire a live user.
PRESENCE_HEARTBEAT_MS=10000
PRESENCE_TTL_SECONDS=30
