# Stage 01 indexing lab config. Copy to .env and adjust.
# Uses host port 5434 to avoid clashing with Stage 00 (5433) or local PG (5432).
DATABASE_URL=postgres://lab:lab@localhost:5434/lab
PG_POOL_MAX=10
# How many messages the seed creates by default (override: npm run seed -- 500000)
SEED_MESSAGES=300000
# How many conversations to spread them across
SEED_CONVERSATIONS=2000
