# Stage 02 concurrency lab config. Copy to .env and adjust.
# Uses host port 5435 to avoid clashing with Stage 00 (5433) or Stage 01 (5434).
DATABASE_URL=postgres://lab:lab@localhost:5435/lab

# The pool size is the STAR of this lab. Small on purpose so you can see
# exhaustion. Experiments also override this per run.
PG_POOL_MAX=10

# How many messages the seed creates.
SEED_MESSAGES=200000
SEED_CONVERSATIONS=1000
