# --- Stage 00 chat config ---
# Copy to .env and adjust. Never commit real secrets.

# HTTP + WebSocket server
PORT=3000
HOST=0.0.0.0

# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://chat:chat@localhost:5433/chat

# Connection pool (small on purpose at this stage)
PG_POOL_MAX=10
PG_POOL_IDLE_MS=30000
PG_STATEMENT_TIMEOUT_MS=5000

# Auth: dev-only shared secret for signing simple tokens.
# In a real deploy use a strong secret from a secrets manager.
AUTH_SECRET=dev-only-change-me

# Logging
LOG_LEVEL=info

# WebSocket heartbeat (ms)
WS_HEARTBEAT_MS=30000
