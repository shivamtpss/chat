{
  "name": "stage-00-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 00 chat: single server + one Postgres, done with best practices (50-100 users).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --enable-source-maps --watch --loader ts-node/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node --loader ts-node/esm src/db/migrate.ts",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "bench:pagination": "node --loader ts-node/esm scripts/bench-pagination.ts",
    "smoke": "node --loader ts-node/esm scripts/smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
