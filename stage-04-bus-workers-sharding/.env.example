# Stage 04 config. Copy to .env and adjust.
# Postgres on 5437, Redis on 6381 (avoids Stage 00-03 and host's 6379).
DATABASE_URL=postgres://chat:chat@localhost:5437/chat
REDIS_URL=redis://localhost:6381

SERVER_ID=A
PORT=3001
HOST=0.0.0.0
WORKER_ID=w1

PG_POOL_MAX=10
AUTH_SECRET=dev-only-change-me
LOG_LEVEL=info

# The durable bus (a Redis Stream) and its consumer group.
BUS_STREAM=chat:messages
BUS_GROUP=persist-workers

# Number of hash partitions for the messages table (sharding key demo).
MESSAGE_PARTITIONS=8

PRESENCE_TTL_SECONDS=30
PRESENCE_HEARTBEAT_MS=10000
